<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Loop Lite — 자동 채점(아이패드 OK)</title>
<style>
  body{font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,system-ui,sans-serif;margin:16px;background:#fffef7;color:#1b1b1b}
  h1{font-size:20px;margin:0 0 8px}
  .card{border:1px solid #e8e2c8;border-radius:12px;padding:12px;margin-bottom:12px;background:#fff}
  textarea,input,button{font:inherit}
  textarea{width:100%;min-height:100px;border:1px solid #e8e2c8;border-radius:10px;padding:10px;background:#fffdfa}
  button{border:1px solid #e8e2c8;border-radius:10px;background:#fff;padding:8px 12px}
  button:disabled{opacity:.5}
  .row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
  #preview{max-width:100%;border:1px dashed #e8e2c8;border-radius:10px;margin-top:8px}
  table{border-collapse:collapse;width:100%;font-size:14px;margin-top:8px}
  th,td{border:1px solid #e8e2c8;padding:6px 8px;text-align:left}
  th{background:#fffbda}
  .ok{color:#0a7d2a;font-weight:700}.no{color:#b00020;font-weight:700}
  .muted{color:#666;font-size:12px}
</style>
</head>
<body>
  <h1>Loop Lite</h1>
  <p class="muted">사진 → 글자 읽기(OCR) → 자동 채점 → 오답노트</p>

  <div class="card">
    <h2>① 정답표</h2>
    <p class="muted">예: <code>1:A 2:D 3:B 4:C 5:A</code> (번호:알파벳)</p>
    <textarea id="answerKey" placeholder="예) 1:A 2:D 3:B 4:C 5:A"></textarea>
    <div class="row" style="margin-top:6px">
      <button id="saveKey">정답표 저장</button>
      <button id="clearKey">지우기</button>
    </div>
  </div>

  <div class="card">
    <h2>② 사진 넣기</h2>
    <div class="row">
      <label>
        <input id="imgInput" type="file" accept="image/*" capture="environment" style="display:none">
        <button id="pickBtn">이미지 업로드/촬영</button>
      </label>
      <button id="ocrBtn" disabled>OCR 실행</button>
      <span id="status" class="muted"></span>
    </div>
    <img id="preview" alt="미리보기">
    <p class="muted">잘 인식되게: 종이를 반듯하게, 밝게. <code>1:A 2:D ...</code>는 굵은 펜으로.</p>
  </div>

  <div class="card">
    <h2>③ 결과</h2>
    <div id="summary" class="muted">아직 결과가 없습니다.</div>
    <table id="resultTable" style="display:none">
      <thead><tr><th>#</th><th>정답</th><th>학생답</th><th>채점</th></tr></thead>
      <tbody></tbody>
    </table>
    <div class="row" style="margin-top:6px">
      <button id="exportBtn" disabled>CSV로 내보내기</button>
      <button id="wrongBtn" disabled>오답노트 복사</button>
    </div>
    <pre id="wrongBox" class="muted" style="white-space:pre-wrap;margin-top:8px"></pre>
  </div>

  <!-- OCR 라이브러리 -->
  <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
  <script>
    // ===== 쉬운 함수들 =====
    const $ = sel => document.querySelector(sel);
    const answerKeyEl = $('#answerKey');
    const saveKey = $('#saveKey'), clearKey = $('#clearKey');
    const imgInput = $('#imgInput'), pickBtn = $('#pickBtn');
    const ocrBtn = $('#ocrBtn'), statusEl = $('#status');
    const preview = $('#preview'), summary = $('#summary');
    const resultTable = $('#resultTable'), tbody = resultTable.querySelector('tbody');
    const exportBtn = $('#exportBtn'), wrongBtn = $('#wrongBtn'), wrongBox = $('#wrongBox');

    // 저장된 정답표 복구
    const saved = localStorage.getItem('loop_answer_key');
    if (saved) answerKeyEl.value = saved;

    function parseKey(text){
      const map = new Map();
      const tokens = text.replace(/\\n/g,' ').trim().split(/\\s+/);
      for (const t of tokens){
        const m = t.match(/^(\\d+)\\s*[:\\-\\.]?\\s*([A-Z])$/i);
        if (m) map.set(parseInt(m[1],10), m[2].toUpperCase());
      }
      return map;
    }
    function answersFromOCR(txt){
      const map = new Map();
      const clean = txt.replace(/[^\\w:\\s\\-\\.]/g,' ').replace(/\\s+/g,' ');
      for (const p of clean.split(' ')){
        const m = p.match(/^(\\d+)\\s*[:\\-\\.]?\\s*([A-D])$/i);
        if (m) map.set(parseInt(m[1],10), m[2].toUpperCase());
      }
      return map;
    }
    function grade(key, stu){
      const nums = Array.from(new Set([...key.keys(), ...stu.keys()])).sort((a,b)=>a-b);
      const rows = []; let correct = 0;
      for (const n of nums){
        const k = key.get(n)||'', s = stu.get(n)||'';
        const ok = k && s && k===s; if (ok) correct++;
        rows.push({n,k,s,ok});
      }
      return {rows, correct, total: nums.length};
    }
    function toCSV(rows){
      const head = 'number,answer,student,correct';
      return [head, ...rows.map(r=>[r.n,r.k,r.s,r.ok?1:0].join(','))].join('\\n');
    }
    function wrongNote(rows){
      return rows.filter(r=>r.k&&r.s&&r.k!==r.s).map(r=>`${r.n}번: 정답 ${r.k}, 내 답 ${r.s}`).join('\\n');
    }

    // 정답표 버튼
    saveKey.onclick = ()=>{ localStorage.setItem('loop_answer_key', answerKeyEl.value.trim()); alert('정답표 저장 완료'); };
    clearKey.onclick = ()=>{ answerKeyEl.value=''; localStorage.removeItem('loop_answer_key'); };

    // 사진 고르기/찍기
    pickBtn.onclick = ()=> imgInput.click();
    let imageBlob = null;
    imgInput.onchange = ()=>{
      const f = imgInput.files[0]; if (!f) return;
      imageBlob = f; preview.src = URL.createObjectURL(f);
      ocrBtn.disabled = false;
    };

    // OCR 실행
    async function runOCR(blob){
      statusEl.textContent = '글자 읽는 중...';
      const worker = await Tesseract.createWorker('kor+eng');
      const { data:{ text } } = await worker.recognize(blob);
      await worker.terminate();
      statusEl.textContent = '완료';
      return text;
    }

    ocrBtn.onclick = async ()=>{
      const keyMap = parseKey(answerKeyEl.value);
      if (!keyMap.size){ alert('먼저 정답표를 적고, 저장해 주세요.'); return; }
      if (!imageBlob){ alert('사진을 업로드(또는 촬영)해 주세요.'); return; }

      ocrBtn.disabled = true;
      try{
        const text = await runOCR(imageBlob);
        const stuMap = answersFromOCR(text);
        if (!stuMap.size){ statusEl.textContent = '패턴을 못 찾았어요. 예: "1:A 2:D 3:B"'; ocrBtn.disabled=false; return; }
        const {rows, correct, total} = grade(keyMap, stuMap);

        // 표 렌더
        tbody.innerHTML = '';
        rows.forEach(r=>{
          const tr = document.createElement('tr');
          tr.innerHTML = `<td>${r.n}</td><td>${r.k||'-'}</td><td>${r.s||'-'}</td><td class="${r.ok?'ok':'no'}">${r.ok?'O':'X'}</td>`;
          tbody.appendChild(tr);
        });
        resultTable.style.display='table';
        summary.textContent = `점수: ${correct}/${total} (${total?Math.round(correct/total*100):0}%)`;

        const wn = wrongNote(rows);
        wrongBox.textContent = wn || '오답 없음 🎉';
        exportBtn.disabled = false; wrongBtn.disabled = false;

        localStorage.setItem('loop_last_csv', toCSV(rows));
        localStorage.setItem('loop_last_wrong', wrongBox.textContent);
      }catch(e){
        console.error(e); statusEl.textContent = '오류가 발생했어요';
      }finally{
        ocrBtn.disabled = false;
      }
    };

    // 내보내기/복사
    exportBtn.onclick = ()=>{
      const csv = localStorage.getItem('loop_last_csv'); if(!csv) return;
      const blob = new Blob([csv], {type:'text/csv;charset=utf-8;'});
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = `loop_result_${Date.now()}.csv`; a.click();
      URL.revokeObjectURL(url);
    };
    wrongBtn.onclick = async ()=>{
      const text = localStorage.getItem('loop_last_wrong') || wrongBox.textContent;
      try{ await navigator.clipboard.writeText(text); alert('오답노트를 복사했어요'); }
      catch{ alert('복사 권한이 거부되었어요. 화면에서 길게 눌러 복사해 주세요.'); }
    };
  </script>
</body>
</html>
